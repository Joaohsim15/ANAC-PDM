# Copie para .env (ignorado pelo Git) e preencha. Os scripts em scripts/t2/ leem este arquivo.

# Projeto e regiao
PROJECT_ID=<ID_DO_PROJETO_GCP>
REGION=us-central1
DATASET=tf_anac

# Ingestao do T1 (scripts/ingest_bronze_vra_to_gcs.py)
GCS_BUCKET=<BUCKET_DA_BRONZE>

# Vertex AI
VERTEX_MODEL_ID=anac_m1_boosted_tree
VERTEX_ENDPOINT_NAME=anac-atraso-endpoint
VERTEX_MACHINE_TYPE=n1-standard-2

# Cloud Run
API_SERVICE=anac-api
# conta do Cloud Run; vazio = conta padrao do Compute Engine
API_SERVICE_ACCOUNT=

# Streaming
TOPIC=anac-voos
DLQ_TOPIC=anac-voos-dlq
SUBSCRIPTION=anac-voos-dataflow
DATAFLOW_JOB=anac-stream-eventos
# conta dos workers do Dataflow; vazio = conta padrao do Compute Engine
DATAFLOW_SERVICE_ACCOUNT=
